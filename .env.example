# PostgreSQL-backed DuckLake metadata.
METADATA_DATABASE=postgres
METADATA_DATABASE_HOST=localhost
METADATA_DATABASE_PORT=5432
METADATA_DATABASE_USERNAME=lakeducktor
METADATA_DATABASE_PASSWORD=change-me
METADATA_DATABASE_NAME=ducklake
# Optional when the database contains exactly one DuckLake metadata schema.
# METADATA_DATABASE_SCHEMA=ducklake
# Explicitly select the lake to maintain. Read-only discovery can leave this empty.
MAINTAIN_LAKES=ducklake
# Explicit opt-in when no schema/list is selected; otherwise mutation is refused.
MAINTAIN_ALL_LAKES=false

# Fixed execution envelope for one worker and one treatment.
DUCKDB_THREADS=4
DUCKDB_MEMORY=4GB

# Long-lived worker loop and health server.
POLL_INTERVAL_SECONDS=60
TREATMENT_STUCK_AFTER_SECONDS=3600
CONFLICT_BACKOFF_BASE_SECONDS=5
CONFLICT_BACKOFF_MAX_SECONDS=60
# Native orphan detection walks storage; do not run it on every poll.
ORPHAN_SCAN_INTERVAL_SECONDS=3600
# Disabled by default. Enable only for a dedicated DuckLake data root.
# Native orphan cleanup treats unrelated objects as deletion candidates.
ORPHAN_CLEANUP_ENABLED=false
METRICS_HOST=0.0.0.0
METRICS_PORT=8000

# Local filesystem storage. The path must be absolute and visible to this
# process. Use this when metadata paths are relative to the lake data root.
# CATALOG_STORAGE=filesystem
# CATALOG_DATA_PATH=/absolute/path/to/lake/

# Docker Compose connection. These values describe the container's view of
# the metadata service and, for filesystem storage, lake volume. They may
# differ from the host values.
# CONTAINER_METADATA_DATABASE_HOST=metadata-postgres
# CONTAINER_METADATA_DATABASE_PORT=5432
# CONTAINER_CATALOG_DATA_PATH=/lake/
# LAKEDUCKTOR_DOCKER_NETWORK=metadata_default
# LAKEDUCKTOR_METRICS_PORT=8001
# Filesystem storage additionally uses compose.filesystem.yml:
# LAKE_HOST_PATH=/absolute/host/path/to/lake
# LAKE_CONTAINER_PATH=/lake

# S3-compatible data storage. Endpoint paths are supported for gateways such
# as the Alluxio OSS S3 proxy at http://host:39999/api/v1/s3.
CATALOG_STORAGE=s3-compatible
CATALOG_STORAGE_ENDPOINT=http://localhost:9000
CATALOG_STORAGE_REGION=us-east-1
CATALOG_STORAGE_ACCESS_KEY_ID=lakeducktor
CATALOG_STORAGE_SECRET_ACCESS_KEY=change-me
CATALOG_STORAGE_BUCKET=ducklake
